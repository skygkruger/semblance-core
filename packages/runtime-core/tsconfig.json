{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "composite": false,
    "baseUrl": "../..",
    "paths": {
      "@semblance/core": ["packages/core/index.ts"],
      "@semblance/core/*": ["packages/core/*"],
      "@semblance/runtime-shared": ["packages/runtime-shared/src/index.ts"],
      "@semblance/runtime-shared/*": ["packages/runtime-shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
