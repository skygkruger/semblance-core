{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/execution-handshake-hello-v1.schema.json",
  "title": "ExecutionHandshakeHelloV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "clientId",
    "clientPublicKey",
    "nonce",
    "timestamp"
  ],
  "properties": {
    "protocolVersion": {
      "const": "execution/v1"
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "clientPublicKey": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
