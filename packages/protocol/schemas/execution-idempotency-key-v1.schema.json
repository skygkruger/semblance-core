{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/execution-idempotency-key-v1.schema.json",
  "title": "ExecutionIdempotencyKeyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "idempotencyKey",
    "clientId",
    "scope",
    "createdAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": "execution/v1"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "task",
        "session"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
