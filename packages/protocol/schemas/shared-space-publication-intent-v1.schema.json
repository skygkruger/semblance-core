{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/shared-space-publication-intent-v1.schema.json",
  "title": "SharedSpacePublicationIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "intentId",
    "sharedSpaceId",
    "publisherMemberId",
    "personalRootId",
    "sourceRecordId",
    "sourceRecordHash",
    "targetDomainId",
    "membershipEpoch",
    "requiresDualApproval",
    "publisherSignature",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "const": "shared-space/v1"
    },
    "intentId": {
      "type": "string",
      "minLength": 1
    },
    "sharedSpaceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sspace-[0-9a-f-]{36}$"
    },
    "publisherMemberId": {
      "type": "string",
      "minLength": 1
    },
    "personalRootId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRecordId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRecordHash": {
      "type": "string",
      "minLength": 1
    },
    "targetDomainId": {
      "type": "string",
      "minLength": 1
    },
    "membershipEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "requiresDualApproval": {
      "type": "boolean"
    },
    "publisherSignature": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
