{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/execution-model-inventory-v1.schema.json",
  "title": "ExecutionModelInventoryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "nodeId",
    "models",
    "inventoryHash",
    "generatedAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": "execution/v1"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "displayName",
          "contextLength",
          "capabilities"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "contextLength": {
            "type": "integer",
            "minimum": 1
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "chat",
                "completion",
                "embedding"
              ]
            }
          },
          "contentHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    },
    "inventoryHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
