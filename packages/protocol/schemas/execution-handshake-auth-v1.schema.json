{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/execution-handshake-auth-v1.schema.json",
  "title": "ExecutionHandshakeAuthV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "clientId",
    "nodeId",
    "nodeNonce",
    "clientSignature",
    "timestamp"
  ],
  "properties": {
    "protocolVersion": {
      "const": "execution/v1"
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "nodeNonce": {
      "type": "string",
      "minLength": 1
    },
    "clientSignature": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
