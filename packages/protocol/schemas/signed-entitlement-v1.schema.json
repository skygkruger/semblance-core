{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/signed-entitlement-v1.schema.json",
  "title": "SignedEntitlementV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entitlementId",
    "memberId",
    "tier",
    "validFrom",
    "validUntil",
    "offlineGraceDays",
    "revocationEpoch",
    "issuerKeyId",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entitlementId": { "type": "string", "minLength": 1 },
    "memberId": { "type": "string", "minLength": 1 },
    "tier": {
      "type": "string",
      "enum": ["founding", "digital-representative", "lifetime"]
    },
    "seat": { "type": "integer", "minimum": 1 },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "offlineGraceDays": { "type": "integer", "minimum": 0 },
    "revocationEpoch": { "type": "integer", "minimum": 0 },
    "issuerKeyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  }
}
