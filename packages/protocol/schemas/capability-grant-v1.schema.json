{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/capability-grant-v1.schema.json",
  "title": "CapabilityGrantV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "principalId",
    "deviceId",
    "processId",
    "sessionId",
    "processType",
    "extensionInstanceId",
    "workflowId",
    "consentReceiptId",
    "executionDestination",
    "resource",
    "operations",
    "purpose",
    "constraints",
    "issuedAt",
    "expiresAt",
    "policyEpoch",
    "revocationEpoch",
    "auditCorrelationId",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "principalId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "processId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "processType": {
      "type": "string",
      "enum": ["kernel", "core", "gateway", "model", "extension-runner", "cloud-broker", "vault"]
    },
    "extensionInstanceId": { "type": ["string", "null"] },
    "workflowId": { "type": "string", "minLength": 1 },
    "consentReceiptId": { "type": ["string", "null"] },
    "executionDestination": {
      "type": "string",
      "enum": ["local", "gateway", "self_hosted", "byo", "semblance_confidential"]
    },
    "resource": {
      "type": "string",
      "enum": ["vault", "gateway", "model", "extension", "commerce", "cloud-transport", "sync"]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "purpose": { "type": "string", "minLength": 1 },
    "dataScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "accounts", "sources", "recordClasses"],
      "properties": {
        "domains": { "type": "array", "items": { "type": "string" } },
        "accounts": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "recordClasses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accounts": { "type": "array", "items": { "type": "string" } },
        "domains": { "type": "array", "items": { "type": "string" } },
        "destinations": { "type": "array", "items": { "type": "string" } },
        "sensitivityCeiling": {
          "type": "string",
          "enum": ["public", "personal", "sensitive", "restricted"]
        },
        "resultLimit": { "type": "integer", "minimum": 1 },
        "valueLimitMinorUnits": { "type": "integer", "minimum": 0 },
        "idempotencyKey": { "type": "string" }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "policyEpoch": { "type": "integer", "minimum": 0 },
    "revocationEpoch": { "type": "integer", "minimum": 0 },
    "auditCorrelationId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  }
}
