{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/execution-health-v1.schema.json",
  "title": "ExecutionHealthV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "compatibleWith",
    "status",
    "nodeId",
    "uptimeSeconds",
    "modelsAvailable",
    "activeSessions",
    "checkedAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": "execution/v1"
    },
    "compatibleWith": {
      "type": "array",
      "minItems": 1,
      "items": {
        "const": "execution/v1"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "unhealthy"
      ]
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "uptimeSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "modelsAvailable": {
      "type": "integer",
      "minimum": 0
    },
    "activeSessions": {
      "type": "integer",
      "minimum": 0
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
