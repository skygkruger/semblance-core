{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/protocol/execution-handshake-challenge-v1.schema.json",
  "title": "ExecutionHandshakeChallengeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "compatibleWith",
    "nodeId",
    "nodePublicKey",
    "helloNonce",
    "nodeNonce",
    "buildHash",
    "timestamp"
  ],
  "properties": {
    "protocolVersion": {
      "const": "execution/v1"
    },
    "compatibleWith": {
      "type": "array",
      "minItems": 1,
      "items": {
        "const": "execution/v1"
      }
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "nodePublicKey": {
      "type": "string",
      "minLength": 1
    },
    "helloNonce": {
      "type": "string",
      "minLength": 1
    },
    "nodeNonce": {
      "type": "string",
      "minLength": 1
    },
    "buildHash": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
