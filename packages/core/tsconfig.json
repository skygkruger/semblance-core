{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@semblance/kernel": ["kernel/src/index.ts"],
      "@semblance/kernel/*": ["kernel/src/*"],
      "@semblance/sync": ["sync/src/index.ts"],
      "@semblance/sync/*": ["sync/src/*"],
      "@semblance/protocol": ["protocol/src/index.ts"],
      "@semblance/protocol/*": ["protocol/src/*"]
    }
  },
  "include": ["llm/**/*.ts", "knowledge/**/*.ts", "agent/**/*.ts", "types/**/*.ts", "extensions/**/*.ts", "skills/**/*.ts", "security/**/*.ts", "credentials/**/*.ts", "index.ts"],
  "references": [
    { "path": "../protocol" },
    { "path": "../kernel" },
    { "path": "../extension-sdk" },
    { "path": "../extension-runner" },
    { "path": "../sync" }
  ],
  "exclude": ["node_modules", "dist"]
}
