{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": ["llm/**/*.ts", "knowledge/**/*.ts", "agent/**/*.ts", "types/**/*.ts", "extensions/**/*.ts", "skills/**/*.ts", "security/**/*.ts", "credentials/**/*.ts", "index.ts"],
  "references": [
    { "path": "../protocol" },
    { "path": "../kernel" },
    { "path": "../extension-sdk" },
    { "path": "../extension-runner" }
  ],
  "exclude": ["node_modules", "dist"]
}
