{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semblance.run/schemas/field-evidence/launch-floor.v1.schema.json",
  "title": "Windows launch-floor field evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "capturedAt",
    "platform",
    "hardwareProfile",
    "readySeconds",
    "pass"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceId": { "const": "performance-launch-floor" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "releaseId": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "object",
      "required": ["os", "osVersion", "arch"],
      "properties": {
        "os": { "const": "windows" },
        "osVersion": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "hardwareProfile": {
      "type": "object",
      "required": ["cpuCores", "ramGiB", "freeDiskGiB"],
      "properties": {
        "cpuCores": { "type": "integer", "minimum": 4 },
        "ramGiB": { "type": "integer", "minimum": 16 },
        "freeDiskGiB": { "type": "integer", "minimum": 20 }
      }
    },
    "readySeconds": { "type": "number", "minimum": 0, "maximum": 90 },
    "pass": { "type": "boolean" },
    "notes": { "type": "string" },
    "artifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
